{% layout "layout.liquid" %}

{% block title %}Gratitude Entry | CBT Workbook{% endblock %}

{% block main %}
<main class="min-h-screen text-white p-4">
  <div class="max-w-3xl mx-auto md:mx-auto bg-gray-900 p-6 rounded-lg shadow-lg">
    <div class="mb-6">
      {% if isPublicView %}
        <a href="/gratitude/board" class="flex items-center text-purple-400 hover:text-purple-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Gratitude Board
        </a>
      {% else %}
        <a href="/gratitude" class="flex items-center text-purple-400 hover:text-purple-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Journal
        </a>
      {% endif %}
    </div>

    <div class="bg-gray-800 rounded-lg overflow-hidden shadow-lg">
      <div class="p-6">
        <header class="mb-6">
          <div class="flex justify-between items-start mb-4">
            <div>
              <div class="text-sm text-gray-400">{{ entry.created_at | date: '%B %d, %Y' }}</div>
              <h1 class="text-2xl font-bold text-purple-400">Gratitude Entry</h1>
              {% if isPublicView and entry.username %}
                <div class="text-sm text-gray-300 mt-1">Shared by {{ entry.username }}</div>
              {% endif %}
            </div>
            <div class="flex items-center space-x-2">
              <span class="px-2 py-1 text-xs rounded bg-gray-700 text-gray-300">{{ entry.category }}</span>
              {% unless isPublicView %}
                {% if entry.is_private %}
                  <span class="px-2 py-1 text-xs rounded bg-gray-700 text-gray-300">Private</span>
                {% else %}
                  <span class="px-2 py-1 text-xs rounded bg-purple-600 text-white">Public</span>
                {% endif %}
              {% endunless %}
            </div>
          </div>
        </header>

        <div class="mb-8">
          <div class="text-lg whitespace-pre-wrap">{{ entry.content }}</div>
        </div>

        {% if entry.media_url %}
          <div class="mb-8">
            <img src="{{ entry.media_url }}" alt="Gratitude entry media" class="w-full rounded-lg">
          </div>
        {% endif %}

        <div class="pt-4 border-t border-gray-700">
          <div class="flex justify-between items-center">
            {% if isPublicView %}
              <div>
                {% if entry.likes_count %}
                  <span class="flex items-center space-x-1 text-red-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
                    </svg>
                    <span>{{ entry.likes_count }}</span> 
                    <span class="text-gray-400 ml-1">people appreciate this</span>
                  </span>
                {% endif %}
              </div>
              <div>
                <a href="/gratitude/board" class="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 transition">
                  Back to Board
                </a>
                {% if isOwner %}
                  <a href="/gratitude/edit/{{ entry.entry_id }}" class="ml-2 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">
                    Edit Entry
                  </a>
                {% endif %}
              </div>
            {% else %}
              <div class="flex items-center space-x-2">
                <a href="/gratitude/edit/{{ entry.entry_id }}" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">
                  Edit Entry
                </a>
                <button 
                  class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition" 
                  hx-delete="/gratitude/{{ entry.entry_id }}"
                  hx-confirm="Are you sure you want to delete this entry?"
                  hx-target="body">
                  Delete
                </button>
              </div>
              
              {% if entry.is_private == false %}
                <div class="text-sm text-gray-400">
                  This entry is visible on the Community Board
                </div>
              {% endif %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
{% endblock %}
