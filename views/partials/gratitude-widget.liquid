<div id="gratitude-widget" class="bg-gray-800 rounded-lg p-6 shadow-lg h-full htmx-widget">
  <!-- {% currentUnixEpoch %} -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left Section: Latest Entry -->
    <div class="lg:col-span-1">
      <h2 class="text-xl font-semibold text-purple-400 mb-4">Your Gratitude Journal</h2>
      
      {% if latestEntry %}
        <div class="bg-gray-700 p-4 rounded-lg mb-4">
          <div class="text-sm text-gray-400 mb-1">Latest Entry ({{ latestEntry.category }})</div>
          <div class="text-sm text-white">{{ latestEntry.content | truncate: 150 }}</div>
          <div class="flex justify-between items-center mt-3">
            <span class="text-xs text-gray-400">{{ latestEntry.created_at | date: '%Y-%m-%d' }}</span>
            {% if latestEntry.is_private %}
              <span class="text-xs px-2 py-1 bg-gray-600 text-gray-300 rounded">Private</span>
            {% else %}
              <span class="text-xs px-2 py-1 bg-purple-600 text-white rounded">Public</span>
            {% endif %}
          </div>
        </div>
        <div class="mb-4 flex justify-between items-center">
          <a href="/gratitude/view/{{ latestEntry.entry_id }}" class="text-sm text-purple-400 hover:text-purple-300">View Details</a>
          <span class="text-xs text-gray-400">{{ totalEntries }} {% if totalEntries != 1 %}entries{% else %}entry{% endif %} total</span>
        </div>
      {% else %}
        <p class="text-gray-300 mb-4">You haven't created any gratitude entries yet. Start by expressing gratitude for something in your life.</p>
      {% endif %}
      
      <div class="mt-4">
        <a href="/gratitude" class="block w-full bg-purple-500 text-center rounded-lg py-2 hover:bg-purple-600 transition">View All Entries</a>
      </div>
    </div>

    <!-- Middle Section: Quick Entry Form -->
    <div class="lg:col-span-1">
      <h2 class="text-xl font-semibold text-purple-400 mb-4">Add New Entry</h2>
      <form 
        hx-post="/gratitude/new" 
        hx-target="#gratitude-widget" 
        hx-swap="outerHTML" 
        enctype="multipart/form-data"
        class="space-y-4">
        <div>
          <label for="content" class="block text-sm font-medium text-gray-300 mb-1">What are you grateful for today?</label>
          <textarea 
            name="content" 
            id="content" 
            rows="4" 
            class="w-full bg-gray-700 text-white rounded-md p-2 focus:ring-2 focus:ring-purple-500 focus:outline-none"
            placeholder="Express your gratitude..."
            required></textarea>
        </div>
        
        <div>
          <label for="category" class="block text-sm font-medium text-gray-300 mb-1">Category</label>
          <select 
            name="category" 
            id="category" 
            class="w-full bg-gray-700 text-white rounded-md p-2 focus:ring-2 focus:ring-purple-500 focus:outline-none">
            <option value="Relationships">Relationships</option>
            <option value="Personal Growth">Personal Growth</option>
            <option value="Nature">Nature</option>
            <option value="Health">Health</option>
            <option value="Daily Life">Daily Life</option>
          </select>
        </div>
        
        <div>
          <label for="media_file" class="block text-sm font-medium text-gray-300 mb-1">Upload Image (Optional)</label>
          <input 
            type="file" 
            name="media_file" 
            id="media_file" 
            accept="image/*"
            class="w-full bg-gray-700 text-white rounded-md p-2 focus:ring-2 focus:ring-purple-500 focus:outline-none">
          <p class="mt-1 text-xs text-gray-400">Max size: 5MB</p>
        </div>
        
        <div class="flex items-center">
          <input 
            type="checkbox" 
            name="is_private" 
            id="is_private" 
            value="true"
            class="rounded bg-gray-700 border-gray-600 text-purple-500 focus:ring-purple-500 focus:ring-offset-gray-800"
            checked>
          <label for="is_private" class="ml-2 block text-sm text-gray-300">Keep this entry private</label>
        </div>
        
         <div>
          <button 
            type="submit" 
            class="w-full bg-purple-600 text-white rounded-lg py-2 hover:bg-purple-700 transition"
            hx-indicator="#submit-spinner">
            <span>Save Entry</span>
            <span id="submit-spinner" class="htmx-indicator ml-2 inline-block align-middle">
              <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </span>
          </button>
        </div>
      </form>
    </div>